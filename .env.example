# ==============================================================================
# YouTube Custom Workflow Automation - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your local values.
# NEVER commit .env with real credentials to source control.

# Local Server Configuration
PORT=3456
NODE_ENV=development

# ComfyUI Connection (Local Video Diffusion Service)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_DIR=D:\comfyui

# AI Script & Scene Planning Providers (Optional - deterministic offline fallback used if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# YouTube Data API v3 (Optional - needed only for authorized YouTube publishing)
YOUTUBE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3456/oauth2callback

# Video Production & Publishing Defaults
DEFAULT_VIDEO_VISIBILITY=private
REQUIRE_HUMAN_APPROVAL=true
AUTO_PUBLISH_ENABLED=false
TARGET_VIDEO_RESOLUTION=1080p
DEFAULT_SCENE_FPS=24
